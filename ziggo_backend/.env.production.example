# Ziggo production env — copy to /var/www/ziggo/.env and fill in real values.
# docker-compose reads this from the repo root (next to docker-compose.yml).
# DO NOT commit the populated .env to git.

# === Required ===

# Postgres
POSTGRES_DB=ziggo
POSTGRES_USER=ziggo
# Generate a strong password:  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT signing secret. Generate one with:
#   openssl rand -hex 48
SECRET_KEY=CHANGE_ME_TO_64_HEX_CHARS

# Free host port to bind the backend to. Existing ports in use on this server:
#   80, 443, 22, 3306, 3000, 8000, 8001, 8010, 8020, 9000, 9090.
# 8030 is free; change if needed but check `ss -tulnp` first.
ZIGGO_PORT=8030

# DEV_MODE=true returns the OTP in /auth/send-otp response (great for dev,
# DISASTROUS in prod). Always false on a public server.
DEV_MODE=false


# === Optional (defaults are fine) ===
PROJECT_NAME=Ziggo
API_V1_STR=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=11520
# (8 days. Lower to e.g. 1440 = 1 day if you want tighter sessions.)


# === Third-party — leave commented out until you wire them ===
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+94...
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_MAPS_API_KEY=
