{
  "permissions": {
    "allow": [
      "Bash(python -c \"from app import models; from app.database import Base; print\\('Tables registered:'\\); [print\\(' -', t.name\\) for t in Base.metadata.sorted_tables]\")",
      "Bash(docker exec *)",
      "Bash(systemctl reload *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" -H \"Host: ziggo.lk\" http://127.0.0.1/)",
      "Bash(curl -s -H \"Host: ziggo.lk\" http://127.0.0.1/)",
      "Read(//var/log/nginx/**)",
      "Bash(curl -s -o /dev/null -w \"GET / -> %{http_code}\\\\n\" -H \"Host: ziggo.lk\" http://127.0.0.1/)",
      "Bash(curl -s -o /dev/null -w \"GET /index.html -> %{http_code}\\\\n\" -H \"Host: ziggo.lk\" http://127.0.0.1/index.html)",
      "Bash(curl -s -o /dev/null -w \"GET /pages/ -> %{http_code}\\\\n\" -H \"Host: ziggo.lk\" http://127.0.0.1/pages/)",
      "Bash(certbot --version)",
      "Bash(certbot --nginx -d ziggo.lk -d www.ziggo.lk --non-interactive --agree-tos --email team@hashnate.com --redirect)",
      "Bash(curl -sI https://ziggo.lk/)",
      "Bash(curl -sI -o /dev/null -w \"http://ziggo.lk -> %{http_code} -> %{redirect_url}\\\\n\" http://ziggo.lk/)"
    ]
  }
}
