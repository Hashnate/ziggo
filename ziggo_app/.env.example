# Ziggo Flutter app — secrets template.
# Copy this file to ziggo_app/.env and fill in real values. The .env file is
# gitignored so it never gets committed. The flutter_dotenv package loads it
# at app startup; see main.dart.

# Google Maps key. Restrict it in Google Cloud Console to:
#   - Android: package name + SHA-1 fingerprint
#   - iOS: bundle ID
#   - Web: HTTP referrer
# and API allowlist: Maps SDK Android, Maps SDK iOS, Maps JS, Places API,
# Directions API, Geocoding API.
GOOGLE_MAPS_API_KEY=
